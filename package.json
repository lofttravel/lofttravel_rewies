{
  "name": "lofttravel-reviews-collector",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Nightly Google Maps and Yandex Maps reviews collector for Loft Travel",
  "scripts": {
    "collect": "node src/collect.mjs",
    "collect:dry": "REVIEWS_DRY_RUN=1 node src/collect.mjs",
    "test": "node --test tests/*.test.mjs",
    "validate": "node src/validate-output.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "playwright": "1.62.1",
    "sharp": "0.35.3"
  }
}
